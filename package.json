{
  "name": "microvm-app",
  "version": "0.1.0",
  "description": "Zero-dependency TypeScript/Node framework for AWS Lambda MicroVMs: lifecycle hook handlers and a lightweight web server.",
  "license": "Apache-2.0",
  "author": "Mike G Chambers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikegc-aws/microvm-app-js.git"
  },
  "keywords": ["aws", "lambda", "microvm", "serverless", "firecracker"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "NOTICE"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
